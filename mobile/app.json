{
  "expo": {
    "name": "Askari",
    "slug": "askari-shopping",
    "scheme": "askari",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "pk.askari.store",
      "supportsTablet": false,
      "infoPlist": {"ITSAppUsesNonExemptEncryption": false}
    },
    "android": {
      "package": "pk.askari.store",
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": {"foregroundImage": "./assets/icon.png", "backgroundColor": "#087e78"},
      "blockedPermissions": ["android.permission.RECORD_AUDIO", "android.permission.CAMERA", "android.permission.ACCESS_BACKGROUND_LOCATION"]
    },
    "plugins": [
      "expo-secure-store",
      ["expo-location", {"locationWhenInUsePermission": "Allow Askari to find your delivery pin when you tap Use my current location.", "isAndroidBackgroundLocationEnabled": false}],
      ["expo-image-picker", {"photosPermission": "Choose a grocery-list photo to share with Askari.", "cameraPermission": false, "microphonePermission": false}]
    ],
    "web": {"favicon": "./assets/favicon.png"},
    "experiments": {"baseUrl": "/mobile-preview"}
  }
}
