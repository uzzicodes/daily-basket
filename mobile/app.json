{
  "expo": {
    "name": "Daily Basket",
    "slug": "daily-basket-shopping",
    "scheme": "dailybasket",
    "version": "1.0.2",
    "icon": "./assets/app-icon-1024-v2.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "pk.dailybasket.shopping",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 3,
      "package": "pk.dailybasket.shopping",
      "predictiveBackGestureEnabled": true,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "icon": "./assets/app-icon-1024-v2.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Daily Basket to find your delivery pin when you tap Use my current location.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a grocery-list photo to share with Daily Basket.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "web": {
      "favicon": "./assets/app-icon-1024-v2.png"
    },
    "experiments": {
      "baseUrl": "/mobile-preview"
    },
    "extra": {
      "eas": {
        "projectId": "2d7cb415-af08-4f09-9694-ae38a7ae1c62"
      }
    },
    "owner": "daily-basket-lahore"
  }
}
