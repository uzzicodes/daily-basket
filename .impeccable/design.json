  "narrative": {
    "northStar": "The Neighbourhood Grocery Shelf",
    "overview": "The built system follows the chosen Quick Basket direction: familiar Pakistani packaging sits on quiet white shelves, with emerald actions and gently tinted supporting surfaces. Figtree gives the storefront and staff counter a shared, compact voice. Product identity comes from real package photographs and the user-supplied Askari logo.\n\nThe original logo artwork stays unaltered. Its transparent padding is removed from the visible frame through CSS positioning and clipping; the artwork's orange and blue remain part of that asset rather than becoming interface accents. Catalog and admin preview notices distinguish demonstration values from live operations. This document records the current implementation; it does not certify an entire review or launch.",
    "keyCharacteristics": [
      "White product shelves, emerald actions and restrained amber savings.",
      "Compact Figtree hierarchy with readable, muted green supporting text.",
      "Contained package photographs, thin separators and gently curved panels.",
      "Quantity controls and delivery progress keep basket changes visible.",
      "Storefront and staff counter share controls, fields and state language."
    ],
    "rules": [
      {
        "name": "The Action Emerald Rule",
        "body": "Use emerald for actionable controls, selection and basket progress; keep merchandise backgrounds white.",
        "section": "colors"
      },
      {
        "name": "The Familiar Name Rule",
        "body": "Keep package names and brands in ordinary case; package photography carries the brand's own lettering.",
        "section": "typography"
      },
      {
        "name": "The Shelf Border Rule",
        "body": "Product and metric cards use borders at rest; overlay depth comes from the existing shadow vocabulary.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** preserve the user-supplied logo artwork and crop only its transparent padding through the existing viewport.",
      "**Do** show actual package photography with contain sizing and legible brand, unit and price text.",
      "**Do** reuse emerald actions, flat bordered shelves and pale-green supporting insets.",
      "**Do** keep the mobile two-column shelf, visible delivery selection and accessible names for icon actions.",
      "**Do** expose preview, validation, disabled, empty and success states with explicit text."
    ],
    "donts": [
      "**Don't** redraw, recolor or replace the supplied logo.",
      "**Don't** turn discount amber into a competing large-area brand accent.",
      "**Don't** inherit hidden decorative eyebrow strings as a new visual pattern.",
      "**Don't** describe demonstration inventory, prices or empty admin preview metrics as live data.",
      "**Don't** claim persistence or photo attachment succeeded when the configured integration cannot do it."
    ]
  }
}