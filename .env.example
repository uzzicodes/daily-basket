# Server only: never prefix these secrets with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Format: international digits only, e.g. 923001234567. Supply the real store number.
STORE_WHATSAPP_NUMBER=923084555567
# Keep true until the store reviews demonstration prices, ratings and stock.
CATALOG_PREVIEW=true
# Optional canonical origin for reverse proxies, e.g. https://your-store.vercel.app
APP_ORIGIN=

# Separate staff access; never share the owner password with counter staff.
ORDER_DESK_PASSWORD=

# Optional order desk Web Push; generate with node scripts/setup-phone-alerts.mjs.
# Keep the private key and dispatch secret server-only. Preserve keys across deployments.
DESK_PUSH_PUBLIC_KEY=
DESK_PUSH_PRIVATE_KEY=
DESK_PUSH_SUBJECT=
DESK_PUSH_DISPATCH_SECRET=
